  "computed": {
    "health_pct": {
      "formula": "concat(health * 10, '%')",
      "label": "Health"
    },
    "evade_total": {
      "formula": "dex_mod + evade_buffs",
      "label": "Evade Total"
    },
    "evade_dex": {
      "formula": "dex_mod",
      "label": "Evade: DEX Mod"
    },
    "dr_total": {
      "formula": "armor + dr_buffs",
      "label": "DR Total"
    },
    "attack_1_to_hit": {
      "formula": "attack_1_name == '' ? '' : signed(attack_1_rank + attack_1_hit_mod)",
      "label": "Attack 1 to hit"
    },
    "attack_2_to_hit": {
      "formula": "attack_2_name == '' ? '' : signed(attack_2_rank + attack_2_hit_mod)",
      "label": "Attack 2 to hit"
    },
    "attack_3_to_hit": {
      "formula": "attack_3_name == '' ? '' : signed(attack_3_rank + attack_3_hit_mod)",
      "label": "Attack 3 to hit"
    },
    "attack_4_to_hit": {
      "formula": "attack_4_name == '' ? '' : signed(attack_4_rank + attack_4_hit_mod)",
      "label": "Attack 4 to hit"
    },
    "attack_5_to_hit": {
      "formula": "attack_5_name == '' ? '' : signed(attack_5_rank + attack_5_hit_mod)",
      "label": "Attack 5 to hit"
    },
    "accessory_count": {
      "formula": "len(accessories)",
      "label": "Accessories"
    }
  },
  "validators": [
    {
      "rule": "mana <= mana_max or mana_max == 0",
      "message": "Current mana is above the maximum."
    },
    {
      "rule": "accessory_count <= 10",
      "message": "More than ten accessories."
    }
  ]
}
