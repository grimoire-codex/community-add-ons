{
  "id": "high-contrast",
  "name": "High Contrast",
  "version": "1.0.0",
  "mode": "dark",
  "app_mode": "grimoire",
  "author": "Grimoire",
  "description": "Maximum legibility: pure black surfaces, white body text, and bright accents. Every foreground clears WCAG AAA (7:1) against every background, and the low-contrast greys of the default theme are removed. Raises luminance contrast only — it does not address colourblindness, which needs more than a change of colour.",
  "homepage": "https://github.com/grimoire-codex/community-add-ons",
  "grimoire_min_version": "1.5.6",
  "tokens": {
    "bg-deep": "#000000",
    "bg-panel": "#050505",
    "bg-card": "#0a0a0a",
    "bg-card-hover": "#1a1a1a",
    "bg-input": "#000000",
    "border": "#767676",
    "border-light": "#a0a0a0",
    "accent": "#ffd54a",
    "accent-dim": "#e6bf35",
    "accent-bright": "#ffe680",
    "accent-alt": "#ffb347",
    "on-accent": "#000000",
    "text": "#ffffff",
    "text-dim": "#e8e8e8",
