    },
    "skill_thievery": {
      "formula": "signed(dexterity + ((contains(skills_legendary, 'Thievery') ? 8 : (contains(skills_master, 'Thievery') ? 6 : (contains(skills_expert, 'Thievery') ? 4 : (contains(skills_trained, 'Thievery') ? 2 : 0)))) > 0 ? level + (contains(skills_legendary, 'Thievery') ? 8 : (contains(skills_master, 'Thievery') ? 6 : (contains(skills_expert, 'Thievery') ? 4 : (contains(skills_trained, 'Thievery') ? 2 : 0)))) : 0))",
      "label": "Thievery"
    },
    "lore_1": {
      "formula": "signed(intelligence + (lore_1_prof > 0 ? level + lore_1_prof : 0))",
      "label": "Lore"
    },
    "lore_2": {
      "formula": "signed(intelligence + (lore_2_prof > 0 ? level + lore_2_prof : 0))",
      "label": "Lore"
    },
    "focus_left": {
      "formula": "max(0, focus_max - focus_used)",
      "label": "Focus Points Left"
    },
    "feat_count": {
      "formula": "count_refs(feats)",
      "label": "Feats"
    },
    "strength_display": {
      "formula": "signed(strength)",
      "label": "Strength"
    },
    "dexterity_display": {
      "formula": "signed(dexterity)",
      "label": "Dexterity"
    },
    "constitution_display": {
      "formula": "signed(constitution)",
      "label": "Constitution"
    },
    "intelligence_display": {
      "formula": "signed(intelligence)",
      "label": "Intelligence"
    },
    "wisdom_display": {
      "formula": "signed(wisdom)",
      "label": "Wisdom"
    },
    "charisma_display": {
      "formula": "signed(charisma)",
      "label": "Charisma"
    }
  },
  "name_field": "hero_name",
  "validators": [
    {
      "rule": "ref(heritage, 'ancestry') == '' or ref(heritage, 'ancestry') == 'Versatile' or ref(ancestry, 'name') == '' or ref(heritage, 'ancestry') == ref(ancestry, 'name')",
      "message": "This heritage belongs to a different ancestry."
    },
    {
      "rule": "level > 1 or (strength <= 4 and dexterity <= 4 and constitution <= 4 and intelligence <= 4 and wisdom <= 4 and charisma <= 4)",
      "message": "At 1st level no attribute modifier can be above +4."
    }
  ],
  "layout_file": "pathfinder-2e.html",
  "styles_file": "pathfinder-2e.css"
}
