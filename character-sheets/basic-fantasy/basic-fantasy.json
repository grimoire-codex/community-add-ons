{
  "$schema": "../../schema/character-sheet.schema.json",
  "id": "basic-fantasy",
  "name": "Basic Fantasy RPG",
  "version": "1.0.0",
  "system": "Basic Fantasy Role-Playing Game",
  "description": "A character sheet for Basic Fantasy RPG: four classes, ascending armour class, and the five saving throws. Uses the default sectioned layout — the game is small enough not to need a custom one.",
  "author": "hunter-read",
  "homepage": "https://www.basicfantasy.org",
  "license": "CC-BY-SA-4.0",
  "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
  "attribution": "Basic Fantasy Role-Playing Game is © Chris Gonnerman, licensed under CC BY-SA 4.0. See basicfantasy.org.",
  "fields": {
    "hero_name": {
      "type": "text",
      "label": "Character Name"
    },
    "player_name": {
      "type": "text",
      "label": "Player"
    },
    "klass": {
      "type": "select",
      "label": "Class",
      "options": [
        "Cleric",
        "Fighter",
        "Magic-User",
        "Thief"
      ]
    },
    "race": {
      "type": "select",
      "label": "Race",
      "options": [
        "Dwarf",
        "Elf",
        "Halfling",
        "Human"
      ]
    },
    "level": {
      "type": "number",
      "label": "Level",
      "min": 1,
      "max": 20,
      "default": 1
    },
    "xp": {
      "type": "number",
      "label": "Experience",
      "min": 0,
      "default": 0
    },
    "strength": {
      "type": "number",
      "label": "Strength",
      "min": 3,
      "max": 18,
      "default": 10
    },
    "dexterity": {
      "type": "number",
      "label": "Dexterity",
      "min": 3,
      "max": 18,
      "default": 10
    },
    "constitution": {
      "type": "number",
      "label": "Constitution",
      "min": 3,
      "max": 18,
      "default": 10
    },
    "intelligence": {
      "type": "number",
      "label": "Intelligence",
      "min": 3,
      "max": 18,
      "default": 10
    },
    "wisdom": {
      "type": "number",
      "label": "Wisdom",
      "min": 3,
      "max": 18,
      "default": 10
    },
    "charisma": {
      "type": "number",
      "label": "Charisma",
      "min": 3,
      "max": 18,
      "default": 10
    },
    "hp_max": {
      "type": "number",
      "label": "Max Hit Points",
      "min": 1,
      "default": 6
    },
    "hp_current": {
      "type": "number",
      "label": "Current Hit Points",
      "default": 6
    },
    "armor_worn": {
      "type": "number",
      "label": "Armour AC",
      "min": 11,
      "default": 11,
      "placeholder": "11 unarmoured"
    },
    "shield": {
      "type": "checkbox",
      "label": "Shield"
    },
    "movement": {
      "type": "number",
      "label": "Movement",
      "min": 0,
      "default": 40
    },
    "saves_death": {
      "type": "number",
      "label": "Death Ray or Poison",
      "default": 12
    },
    "saves_wands": {
      "type": "number",
      "label": "Magic Wands",
      "default": 13
    },
    "saves_paralysis": {
      "type": "number",
      "label": "Paralysis or Petrify",
      "default": 14
    },
    "saves_breath": {
      "type": "number",
      "label": "Dragon Breath",
      "default": 15
    },
    "saves_spells": {
      "type": "number",
      "label": "Spells",
      "default": 16
    },
    "spells_known": {
      "type": "textarea",
      "label": "Spells",
      "rows": 6,
      "visible_if": "klass == 'Cleric' or klass == 'Magic-User'"
    },
    "equipment": {
      "type": "list",
      "label": "Equipment",
      "columns": [
        {
          "key": "name",
          "type": "text",
          "label": "Item",
          "flex": 3
        },
        {
          "key": "qty",
          "type": "number",
          "label": "Qty",
          "default": 1,
          "min": 0,
          "flex": 1
        },
        {
          "key": "weight",
          "type": "number",
          "label": "Lb",
          "default": 0,
          "min": 0,
          "flex": 1
        }
      ]
    },
    "gold": {
      "type": "number",
      "label": "Gold",
      "min": 0,
      "default": 0
    },
    "notes": {
      "type": "textarea",
      "label": "Notes",
      "rows": 6
    }
  },
  "computed": {
    "strength_bonus": {
      "formula": "signed(strength <= 3 ? -3 : (strength <= 5 ? -2 : (strength <= 8 ? -1 : (strength <= 12 ? 0 : (strength <= 15 ? 1 : (strength <= 17 ? 2 : 3))))))",
      "label": "STR Bonus"
    },
    "dexterity_bonus": {
      "formula": "signed(dexterity <= 3 ? -3 : (dexterity <= 5 ? -2 : (dexterity <= 8 ? -1 : (dexterity <= 12 ? 0 : (dexterity <= 15 ? 1 : (dexterity <= 17 ? 2 : 3))))))",
      "label": "DEX Bonus"
    },
    "constitution_bonus": {
      "formula": "signed(constitution <= 3 ? -3 : (constitution <= 5 ? -2 : (constitution <= 8 ? -1 : (constitution <= 12 ? 0 : (constitution <= 15 ? 1 : (constitution <= 17 ? 2 : 3))))))",
      "label": "CON Bonus"
    },
    "intelligence_bonus": {
      "formula": "signed(intelligence <= 3 ? -3 : (intelligence <= 5 ? -2 : (intelligence <= 8 ? -1 : (intelligence <= 12 ? 0 : (intelligence <= 15 ? 1 : (intelligence <= 17 ? 2 : 3))))))",
      "label": "INT Bonus"
    },
    "wisdom_bonus": {
      "formula": "signed(wisdom <= 3 ? -3 : (wisdom <= 5 ? -2 : (wisdom <= 8 ? -1 : (wisdom <= 12 ? 0 : (wisdom <= 15 ? 1 : (wisdom <= 17 ? 2 : 3))))))",
      "label": "WIS Bonus"
    },
    "charisma_bonus": {
      "formula": "signed(charisma <= 3 ? -3 : (charisma <= 5 ? -2 : (charisma <= 8 ? -1 : (charisma <= 12 ? 0 : (charisma <= 15 ? 1 : (charisma <= 17 ? 2 : 3))))))",
      "label": "CHA Bonus"
    },
    "armor_class": {
      "formula": "armor_worn + (shield ? 1 : 0) + (dexterity <= 3 ? -3 : (dexterity <= 5 ? -2 : (dexterity <= 8 ? -1 : (dexterity <= 12 ? 0 : (dexterity <= 15 ? 1 : (dexterity <= 17 ? 2 : 3))))))",
      "label": "Armour Class"
    },
    "carried_weight": {
      "formula": "sum_where(equipment, 'weight')",
      "label": "Weight Carried"
    },
    "encumbered_at": {
      "formula": "150 + (strength <= 3 ? -3 : (strength <= 5 ? -2 : (strength <= 8 ? -1 : (strength <= 12 ? 0 : (strength <= 15 ? 1 : (strength <= 17 ? 2 : 3)))))) * 10",
      "label": "Encumbered At"
    },
    "is_encumbered": {
      "formula": "carried_weight > encumbered_at ? 'Encumbered' : 'Unencumbered'",
      "label": "Load"
    }
  },
  "layout": [
    {
      "title": "Character",
      "fields": [
        "hero_name",
        "player_name",
        "klass",
        "race",
        "level",
        "xp"
      ]
    },
    {
      "title": "Abilities",
      "fields": [
        "strength",
        "strength_bonus",
        "dexterity",
        "dexterity_bonus",
        "constitution",
        "constitution_bonus",
        "intelligence",
        "intelligence_bonus",
        "wisdom",
        "wisdom_bonus",
        "charisma",
        "charisma_bonus"
      ]
    },
    {
      "title": "Combat",
      "fields": [
        "hp_current",
        "hp_max",
        "armor_worn",
        "shield",
        "armor_class",
        "movement"
      ]
    },
    {
      "title": "Saving Throws",
      "fields": [
        "saves_death",
        "saves_wands",
        "saves_paralysis",
        "saves_breath",
        "saves_spells"
      ]
    },
    {
      "title": "Spells",
      "visible_if": "klass == 'Cleric' or klass == 'Magic-User'",
      "fields": [
        "spells_known"
      ]
    },
    {
      "title": "Equipment",
      "fields": [
        "equipment",
        "gold",
        "carried_weight",
        "encumbered_at",
        "is_encumbered"
      ]
    },
    {
      "title": "Notes",
      "fields": [
        "notes"
      ]
    }
  ]
}
