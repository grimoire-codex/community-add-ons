        "Gymnastics",
        "Handle Animals",
        "Heal",
        "Hide",
        "History",
        "Interrogate",
        "Intimidate",
        "Jewelry",
        "Jump",
        "Lead",
        "Lie",
        "Lift",
        "Magic",
        "Mechanics",
        "Monsters",
        "Music",
        "Nature",
        "Navigate",
        "Perform",
        "Persuade",
        "Pick Lock",
        "Pick Pocket",
        "Psionics",
        "Read Person",
        "Religion",
