  "computed": {
    "armor_class": {
      "formula": "10 + min(dexterity, ac_dex_cap) + ac_item_bonus + (ac_prof > 0 ? level + ac_prof : 0) + (shield_raised ? shield_bonus : 0)",
      "label": "Armor Class"
    },
    "fortitude": {
      "formula": "signed(constitution + (fortitude_prof > 0 ? level + fortitude_prof : 0))",
      "label": "Fortitude"
    },
    "reflex": {
      "formula": "signed(dexterity + (reflex_prof > 0 ? level + reflex_prof : 0))",
      "label": "Reflex"
    },
    "will": {
      "formula": "signed(wisdom + (will_prof > 0 ? level + will_prof : 0))",
      "label": "Will"
    },
    "perception": {
      "formula": "signed(wisdom + (perception_prof > 0 ? level + perception_prof : 0))",
      "label": "Perception"
    },
    "class_dc": {
      "formula": "10 + (class_dc_prof > 0 ? level + class_dc_prof : 0) + (key_ability == 'strength' ? strength : (key_ability == 'dexterity' ? dexterity : (key_ability == 'constitution' ? constitution : (key_ability == 'intelligence' ? intelligence : (key_ability == 'wisdom' ? wisdom : charisma)))))",
      "label": "Class DC"
    },
    "spell_dc": {
      "formula": "10 + (spell_prof > 0 ? level + spell_prof : 0) + (key_ability == 'intelligence' ? intelligence : (key_ability == 'wisdom' ? wisdom : charisma))",
      "label": "Spell DC"
    },
    "spell_attack": {
      "formula": "signed((spell_prof > 0 ? level + spell_prof : 0) + (key_ability == 'intelligence' ? intelligence : (key_ability == 'wisdom' ? wisdom : charisma)))",
      "label": "Spell Attack"
    },
    "bulk_carried": {
      "formula": "sum_where(equipment, 'bulk')",
      "label": "Bulk"
    },
    "bulk_limit": {
      "formula": "5 + strength",
      "label": "Bulk Limit"
    },
    "invested_count": {
      "formula": "count_where(equipment, 'invested')",
      "label": "Invested"
    },
    "prepared_count": {
      "formula": "count_refs(spells, 'prepared')",
      "label": "Prepared"
    },
    "skill_acrobatics": {
      "formula": "signed(dexterity + ((contains(skills_legendary, 'Acrobatics') ? 8 : (contains(skills_master, 'Acrobatics') ? 6 : (contains(skills_expert, 'Acrobatics') ? 4 : (contains(skills_trained, 'Acrobatics') ? 2 : 0)))) > 0 ? level + (contains(skills_legendary, 'Acrobatics') ? 8 : (contains(skills_master, 'Acrobatics') ? 6 : (contains(skills_expert, 'Acrobatics') ? 4 : (contains(skills_trained, 'Acrobatics') ? 2 : 0)))) : 0))",
      "label": "Acrobatics"
    },
    "skill_arcana": {
      "formula": "signed(intelligence + ((contains(skills_legendary, 'Arcana') ? 8 : (contains(skills_master, 'Arcana') ? 6 : (contains(skills_expert, 'Arcana') ? 4 : (contains(skills_trained, 'Arcana') ? 2 : 0)))) > 0 ? level + (contains(skills_legendary, 'Arcana') ? 8 : (contains(skills_master, 'Arcana') ? 6 : (contains(skills_expert, 'Arcana') ? 4 : (contains(skills_trained, 'Arcana') ? 2 : 0)))) : 0))",
      "label": "Arcana"
    },
    "skill_athletics": {
      "formula": "signed(strength + ((contains(skills_legendary, 'Athletics') ? 8 : (contains(skills_master, 'Athletics') ? 6 : (contains(skills_expert, 'Athletics') ? 4 : (contains(skills_trained, 'Athletics') ? 2 : 0)))) > 0 ? level + (contains(skills_legendary, 'Athletics') ? 8 : (contains(skills_master, 'Athletics') ? 6 : (contains(skills_expert, 'Athletics') ? 4 : (contains(skills_trained, 'Athletics') ? 2 : 0)))) : 0))",
      "label": "Athletics"
    },
    "skill_crafting": {
      "formula": "signed(intelligence + ((contains(skills_legendary, 'Crafting') ? 8 : (contains(skills_master, 'Crafting') ? 6 : (contains(skills_expert, 'Crafting') ? 4 : (contains(skills_trained, 'Crafting') ? 2 : 0)))) > 0 ? level + (contains(skills_legendary, 'Crafting') ? 8 : (contains(skills_master, 'Crafting') ? 6 : (contains(skills_expert, 'Crafting') ? 4 : (contains(skills_trained, 'Crafting') ? 2 : 0)))) : 0))",
      "label": "Crafting"
    },
    "skill_deception": {
      "formula": "signed(charisma + ((contains(skills_legendary, 'Deception') ? 8 : (contains(skills_master, 'Deception') ? 6 : (contains(skills_expert, 'Deception') ? 4 : (contains(skills_trained, 'Deception') ? 2 : 0)))) > 0 ? level + (contains(skills_legendary, 'Deception') ? 8 : (contains(skills_master, 'Deception') ? 6 : (contains(skills_expert, 'Deception') ? 4 : (contains(skills_trained, 'Deception') ? 2 : 0)))) : 0))",
