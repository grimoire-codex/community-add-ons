  "computed": {
    "proficiency": {
      "formula": "2 + floor((level - 1) / 4)",
      "label": "Proficiency Bonus"
    },
    "half_proficiency": {
      "formula": "floor(proficiency / 2)",
      "label": "Half Proficiency Bonus"
    },
    "strength_score": {
      "formula": "strength + strength_bonus",
      "label": "Strength Score"
    },
    "strength_mod": {
      "formula": "floor((strength_score - 10) / 2)",
      "label": "STR Modifier"
    },
    "strength_save": {
      "formula": "signed(strength_mod + (strength_save_prof ? proficiency : 0))",
      "label": "STR Save"
    },
    "dexterity_score": {
      "formula": "dexterity + dexterity_bonus",
      "label": "Dexterity Score"
    },
    "dexterity_mod": {
      "formula": "floor((dexterity_score - 10) / 2)",
      "label": "DEX Modifier"
    },
    "dexterity_save": {
      "formula": "signed(dexterity_mod + (dexterity_save_prof ? proficiency : 0))",
      "label": "DEX Save"
    },
    "constitution_score": {
      "formula": "constitution + constitution_bonus",
      "label": "Constitution Score"
    },
    "constitution_mod": {
      "formula": "floor((constitution_score - 10) / 2)",
      "label": "CON Modifier"
    },
    "constitution_save": {
      "formula": "signed(constitution_mod + (constitution_save_prof ? proficiency : 0))",
      "label": "CON Save"
    },
    "intelligence_score": {
      "formula": "intelligence + intelligence_bonus",
      "label": "Intelligence Score"
    },
    "intelligence_mod": {
      "formula": "floor((intelligence_score - 10) / 2)",
      "label": "INT Modifier"
    },
    "intelligence_save": {
      "formula": "signed(intelligence_mod + (intelligence_save_prof ? proficiency : 0))",
      "label": "INT Save"
    },
    "wisdom_score": {
      "formula": "wisdom + wisdom_bonus",
      "label": "Wisdom Score"
    },
    "wisdom_mod": {
      "formula": "floor((wisdom_score - 10) / 2)",
      "label": "WIS Modifier"
    },
    "wisdom_save": {
      "formula": "signed(wisdom_mod + (wisdom_save_prof ? proficiency : 0))",
      "label": "WIS Save"
    },
    "charisma_score": {
      "formula": "charisma + charisma_bonus",
      "label": "Charisma Score"
    },
    "charisma_mod": {
      "formula": "floor((charisma_score - 10) / 2)",
      "label": "CHA Modifier"
    },
    "charisma_save": {
      "formula": "signed(charisma_mod + (charisma_save_prof ? proficiency : 0))",
      "label": "CHA Save"
    },
    "skill_acrobatics": {
      "formula": "signed(dexterity_mod + (contains(skill_expertise, 'Acrobatics') ? 2 * proficiency : (contains(skill_profs, 'Acrobatics') ? proficiency : (contains(skill_half_profs, 'Acrobatics') ? floor(proficiency / 2) : 0))))",
      "label": "Acrobatics"
    },
    "skill_animal_handling": {
      "formula": "signed(wisdom_mod + (contains(skill_expertise, 'Animal Handling') ? 2 * proficiency : (contains(skill_profs, 'Animal Handling') ? proficiency : (contains(skill_half_profs, 'Animal Handling') ? floor(proficiency / 2) : 0))))",
      "label": "Animal Handling"
    },
    "skill_arcana": {
      "formula": "signed(intelligence_mod + (contains(skill_expertise, 'Arcana') ? 2 * proficiency : (contains(skill_profs, 'Arcana') ? proficiency : (contains(skill_half_profs, 'Arcana') ? floor(proficiency / 2) : 0))))",
      "label": "Arcana"
    },
    "skill_athletics": {
      "formula": "signed(strength_mod + (contains(skill_expertise, 'Athletics') ? 2 * proficiency : (contains(skill_profs, 'Athletics') ? proficiency : (contains(skill_half_profs, 'Athletics') ? floor(proficiency / 2) : 0))))",
      "label": "Athletics"
    },
    "skill_deception": {
      "formula": "signed(charisma_mod + (contains(skill_expertise, 'Deception') ? 2 * proficiency : (contains(skill_profs, 'Deception') ? proficiency : (contains(skill_half_profs, 'Deception') ? floor(proficiency / 2) : 0))))",
      "label": "Deception"
    },
    "skill_history": {
      "formula": "signed(intelligence_mod + (contains(skill_expertise, 'History') ? 2 * proficiency : (contains(skill_profs, 'History') ? proficiency : (contains(skill_half_profs, 'History') ? floor(proficiency / 2) : 0))))",
      "label": "History"
    },
    "skill_insight": {
      "formula": "signed(wisdom_mod + (contains(skill_expertise, 'Insight') ? 2 * proficiency : (contains(skill_profs, 'Insight') ? proficiency : (contains(skill_half_profs, 'Insight') ? floor(proficiency / 2) : 0))))",
      "label": "Insight"
    },
    "skill_intimidation": {
      "formula": "signed(charisma_mod + (contains(skill_expertise, 'Intimidation') ? 2 * proficiency : (contains(skill_profs, 'Intimidation') ? proficiency : (contains(skill_half_profs, 'Intimidation') ? floor(proficiency / 2) : 0))))",
      "label": "Intimidation"
    },
    "skill_investigation": {
      "formula": "signed(intelligence_mod + (contains(skill_expertise, 'Investigation') ? 2 * proficiency : (contains(skill_profs, 'Investigation') ? proficiency : (contains(skill_half_profs, 'Investigation') ? floor(proficiency / 2) : 0))))",
      "label": "Investigation"
    },
    "skill_medicine": {
      "formula": "signed(wisdom_mod + (contains(skill_expertise, 'Medicine') ? 2 * proficiency : (contains(skill_profs, 'Medicine') ? proficiency : (contains(skill_half_profs, 'Medicine') ? floor(proficiency / 2) : 0))))",
      "label": "Medicine"
    },
    "skill_nature": {
      "formula": "signed(intelligence_mod + (contains(skill_expertise, 'Nature') ? 2 * proficiency : (contains(skill_profs, 'Nature') ? proficiency : (contains(skill_half_profs, 'Nature') ? floor(proficiency / 2) : 0))))",
      "label": "Nature"
    },
    "skill_perception": {
      "formula": "signed(wisdom_mod + (contains(skill_expertise, 'Perception') ? 2 * proficiency : (contains(skill_profs, 'Perception') ? proficiency : (contains(skill_half_profs, 'Perception') ? floor(proficiency / 2) : 0))))",
      "label": "Perception"
    },
    "skill_performance": {
      "formula": "signed(charisma_mod + (contains(skill_expertise, 'Performance') ? 2 * proficiency : (contains(skill_profs, 'Performance') ? proficiency : (contains(skill_half_profs, 'Performance') ? floor(proficiency / 2) : 0))))",
      "label": "Performance"
    },
    "skill_persuasion": {
      "formula": "signed(charisma_mod + (contains(skill_expertise, 'Persuasion') ? 2 * proficiency : (contains(skill_profs, 'Persuasion') ? proficiency : (contains(skill_half_profs, 'Persuasion') ? floor(proficiency / 2) : 0))))",
      "label": "Persuasion"
    },
    "skill_religion": {
      "formula": "signed(intelligence_mod + (contains(skill_expertise, 'Religion') ? 2 * proficiency : (contains(skill_profs, 'Religion') ? proficiency : (contains(skill_half_profs, 'Religion') ? floor(proficiency / 2) : 0))))",
      "label": "Religion"
    },
    "skill_sleight_of_hand": {
      "formula": "signed(dexterity_mod + (contains(skill_expertise, 'Sleight of Hand') ? 2 * proficiency : (contains(skill_profs, 'Sleight of Hand') ? proficiency : (contains(skill_half_profs, 'Sleight of Hand') ? floor(proficiency / 2) : 0))))",
      "label": "Sleight of Hand"
    },
    "skill_stealth": {
      "formula": "signed(dexterity_mod + (contains(skill_expertise, 'Stealth') ? 2 * proficiency : (contains(skill_profs, 'Stealth') ? proficiency : (contains(skill_half_profs, 'Stealth') ? floor(proficiency / 2) : 0))))",
      "label": "Stealth"
    },
    "skill_survival": {
      "formula": "signed(wisdom_mod + (contains(skill_expertise, 'Survival') ? 2 * proficiency : (contains(skill_profs, 'Survival') ? proficiency : (contains(skill_half_profs, 'Survival') ? floor(proficiency / 2) : 0))))",
      "label": "Survival"
    },
    "initiative": {
      "formula": "signed(dexterity_mod)",
      "label": "Initiative"
    },
    "armor_class": {
      "formula": "10 + dexterity_mod + armor_bonus + (shield ? 2 : 0)",
      "label": "Armour Class"
    },
    "passive_perception": {
      "formula": "10 + wisdom_mod + (contains(skill_expertise, 'Perception') ? 2 * proficiency : (contains(skill_profs, 'Perception') ? proficiency : (contains(skill_half_profs, 'Perception') ? floor(proficiency / 2) : 0)))",
      "label": "Passive Perception"
    },
    "spell_mod": {
      "formula": "spell_ability == 'intelligence' ? intelligence_mod : (spell_ability == 'wisdom' ? wisdom_mod : (spell_ability == 'charisma' ? charisma_mod : 0))",
      "label": "Spellcasting Modifier"
    },
    "spell_save_dc": {
      "formula": "8 + proficiency + spell_mod",
      "label": "Spell Save DC"
    },
    "spell_attack": {
      "formula": "signed(proficiency + spell_mod)",
      "label": "Spell Attack"
    },
    "prepared_count": {
      "formula": "count_refs(spells, 'prepared')",
      "label": "Spells Prepared"
    },
    "carried_weight": {
      "formula": "sum_qty(equipment, 'weight')",
      "label": "Weight Carried"
    },
    "carry_capacity": {
      "formula": "strength_score * 15",
      "label": "Carrying Capacity"
    },
    "attuned_count": {
      "formula": "count_refs(magic_items, 'attuned')",
      "label": "Attuned Items"
    }
  },
  "layout_file": "dnd-5e-2024.html",
  "styles_file": "dnd-5e-2024.css",
  "name_field": "hero_name",
  "validators": [
    {
      "rule": "strength_bonus + dexterity_bonus + constitution_bonus + intelligence_bonus + wisdom_bonus + charisma_bonus <= 3",
      "message": "A background grants +2 and +1, or +1 to three abilities - 3 in total."
    },
    {
      "rule": "ref(background, 'ability_scores') == '' or ((strength_bonus == 0 or contains(ref(background, 'ability_scores'), 'strength')) and (dexterity_bonus == 0 or contains(ref(background, 'ability_scores'), 'dexterity')) and (constitution_bonus == 0 or contains(ref(background, 'ability_scores'), 'constitution')) and (intelligence_bonus == 0 or contains(ref(background, 'ability_scores'), 'intelligence')) and (wisdom_bonus == 0 or contains(ref(background, 'ability_scores'), 'wisdom')) and (charisma_bonus == 0 or contains(ref(background, 'ability_scores'), 'charisma')))",
      "message": "A background bonus is on an ability your background does not list."
    },
    {
      "rule": "attuned_count <= 3",
      "message": "More than three magic items are attuned - a creature can attune to no more than three at once."
    }
  ]
}
