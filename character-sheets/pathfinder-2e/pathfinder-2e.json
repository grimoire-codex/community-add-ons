    "senses": {
      "type": "text",
      "label": "Senses",
      "default_from": "ref(ancestry, 'vision')"
    },
    "languages": {
      "type": "text",
      "label": "Languages",
      "default_from": "ref(ancestry, 'languages')"
    },
    "armor_category": {
      "type": "select",
      "label": "Armor Worn",
      "default": "unarmored",
      "options": [
        {
          "value": "unarmored",
          "label": "Unarmored"
        },
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "heavy",
          "label": "Heavy"
        }
      ]
    },
    "ac_prof": {
      "type": "select",
      "label": "Armor Proficiency",
      "options": [
        {
          "value": 0,
          "label": "Untrained"
        },
        {
          "value": 2,
          "label": "Trained"
        },
        {
          "value": 4,
          "label": "Expert"
        },
        {
          "value": 6,
          "label": "Master"
        },
        {
          "value": 8,
          "label": "Legendary"
        }
      ],
      "default": 2,
      "default_from": "ref(klass, 'unarmored') == '' ? '' : (armor_category == 'heavy' ? ref(klass, 'heavy_armor') : (armor_category == 'medium' ? ref(klass, 'medium_armor') : (armor_category == 'light' ? ref(klass, 'light_armor') : ref(klass, 'unarmored'))))"
    },
    "ac_item_bonus": {
      "type": "number",
      "label": "Armour Item Bonus",
      "min": 0,
      "default": 0
