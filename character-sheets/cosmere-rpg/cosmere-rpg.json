{
  "$schema": "../../schema/character-sheet.schema.json",
  "id": "cosmere-rpg",
  "name": "Cosmere RPG",
  "version": "1.0.0",
  "system": "Cosmere Roleplaying Game",
  "description": "A character sheet for Brandon Sanderson's Cosmere Roleplaying Game, after the Mistborn campaign setting sheet: six attributes and the three defenses they make, health, focus and Investiture, the eighteen skills with their ranks and modifiers, lifting capacity, movement, recovery die and senses range, and purpose, obstacle and goals.",
  "author": "hunter-read",
  "homepage": "https://www.cosmererpg.com/fan-content-policy",
  "license": "Cosmere RPG Fan Content Policy",
  "license_url": "https://www.cosmererpg.com/fan-content-policy",
  "attribution": "This is unofficial fan content, created and shared for non-commercial use. It has not been reviewed by Dragonsteel Entertainment, LLC or Brotherwise Games, LLC.",
  "name_field": "hero_name",
  "layout_file": "cosmere-rpg.html",
  "styles_file": "cosmere-rpg.css",
