    "spells": {
      "type": "content_list",
      "label": "Cantrips & Prepared Spells",
      "content_type": "spell",
      "allow_freeform": true,
      "visible_if": "is_caster",
      "per_entry_fields": {
        "prepared": {
          "type": "checkbox",
          "label": "Prep"
        }
      },
      "display_columns": [
        "level",
        "casting_time",
        "range",
        "components"
      ]
    },
    "feats": {
      "type": "content_list",
      "label": "Feats",
      "content_type": "feat",
      "allow_freeform": true
    },
    "equipment": {
      "type": "list",
      "label": "Equipment",
      "columns": [
        {
          "key": "name",
          "type": "text",
          "label": "Item",
          "flex": 3
        },
        {
          "key": "qty",
          "type": "number",
          "label": "Qty",
          "default": 1,
          "min": 0,
          "flex": 1
        },
        {
          "key": "weight",
          "type": "number",
          "label": "Lb",
          "default": 0,
          "min": 0,
          "flex": 1
        },
        {
          "key": "equipped",
          "type": "checkbox",
          "label": "Eq."
        }
      ]
    },
    "attacks": {
      "type": "list",
      "label": "Weapons & Damage Cantrips",
      "columns": [
        {
          "key": "name",
          "type": "text",
          "label": "Name",
          "flex": 3
        },
        {
          "key": "bonus",
          "type": "text",
