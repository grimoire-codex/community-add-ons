  "computed": {
    "physical_defense": {
      "formula": "10 + strength + speed",
      "label": "Physical Defense"
    },
    "cognitive_defense": {
      "formula": "10 + intellect + willpower",
      "label": "Cognitive Defense"
    },
    "spiritual_defense": {
      "formula": "10 + awareness + presence",
      "label": "Spiritual Defense"
    },
    "lifting_capacity": {
      "formula": "min(ceil(strength / 2), 5) == 0 ? '100 lb' : (min(ceil(strength / 2), 5) == 1 ? '200 lb' : (min(ceil(strength / 2), 5) == 2 ? '500 lb' : (min(ceil(strength / 2), 5) == 3 ? '1,000 lb' : (min(ceil(strength / 2), 5) == 4 ? '5,000 lb' : ('10,000 lb')))))",
      "label": "Lifting Capacity"
    },
    "carrying_capacity": {
      "formula": "min(ceil(strength / 2), 5) == 0 ? '50 lb' : (min(ceil(strength / 2), 5) == 1 ? '100 lb' : (min(ceil(strength / 2), 5) == 2 ? '250 lb' : (min(ceil(strength / 2), 5) == 3 ? '500 lb' : (min(ceil(strength / 2), 5) == 4 ? '2,500 lb' : ('5,000 lb')))))",
      "label": "Carrying Capacity"
    },
    "movement": {
      "formula": "min(ceil(speed / 2), 5) == 0 ? '20 ft' : (min(ceil(speed / 2), 5) == 1 ? '25 ft' : (min(ceil(speed / 2), 5) == 2 ? '30 ft' : (min(ceil(speed / 2), 5) == 3 ? '40 ft' : (min(ceil(speed / 2), 5) == 4 ? '60 ft' : ('80 ft')))))",
      "label": "Movement"
    },
    "recovery_die": {
      "formula": "min(ceil(willpower / 2), 5) == 0 ? 'd4' : (min(ceil(willpower / 2), 5) == 1 ? 'd6' : (min(ceil(willpower / 2), 5) == 2 ? 'd8' : (min(ceil(willpower / 2), 5) == 3 ? 'd10' : (min(ceil(willpower / 2), 5) == 4 ? 'd12' : ('d20')))))",
      "label": "Recovery Die"
    },
    "senses_range": {
      "formula": "min(ceil(awareness / 2), 5) == 0 ? '5 ft' : (min(ceil(awareness / 2), 5) == 1 ? '10 ft' : (min(ceil(awareness / 2), 5) == 2 ? '20 ft' : (min(ceil(awareness / 2), 5) == 3 ? '50 ft' : (min(ceil(awareness / 2), 5) == 4 ? '100 ft' : ('Unaffected by obscured senses')))))",
      "label": "Senses Range"
    },
    "sk_agility_mod": {
      "formula": "speed + sk_agility",
      "label": "Agility (SPD)"
    },
    "sk_athletics_mod": {
      "formula": "strength + sk_athletics",
      "label": "Athletics (STR)"
    },
    "sk_heavy_weaponry_mod": {
      "formula": "strength + sk_heavy_weaponry",
      "label": "Heavy Weaponry (STR)"
    },
    "sk_light_weaponry_mod": {
      "formula": "speed + sk_light_weaponry",
      "label": "Light Weaponry (SPD)"
    },
    "sk_stealth_mod": {
      "formula": "speed + sk_stealth",
      "label": "Stealth (SPD)"
    },
    "sk_thievery_mod": {
      "formula": "speed + sk_thievery",
      "label": "Thievery (SPD)"
    },
    "sk_crafting_mod": {
      "formula": "intellect + sk_crafting",
      "label": "Crafting (INT)"
    },
    "sk_deduction_mod": {
      "formula": "intellect + sk_deduction",
      "label": "Deduction (INT)"
    },
    "sk_discipline_mod": {
      "formula": "willpower + sk_discipline",
      "label": "Discipline (WIL)"
    },
    "sk_intimidation_mod": {
      "formula": "willpower + sk_intimidation",
      "label": "Intimidation (WIL)"
    },
    "sk_lore_mod": {
      "formula": "intellect + sk_lore",
      "label": "Lore (INT)"
    },
    "sk_medicine_mod": {
      "formula": "intellect + sk_medicine",
      "label": "Medicine (INT)"
    },
    "sk_deception_mod": {
      "formula": "presence + sk_deception",
      "label": "Deception (PRE)"
    },
    "sk_insight_mod": {
      "formula": "awareness + sk_insight",
      "label": "Insight (AWA)"
    },
    "sk_leadership_mod": {
      "formula": "presence + sk_leadership",
      "label": "Leadership (PRE)"
    },
    "sk_perception_mod": {
      "formula": "awareness + sk_perception",
      "label": "Perception (AWA)"
    },
    "sk_persuasion_mod": {
      "formula": "presence + sk_persuasion",
      "label": "Persuasion (PRE)"
    },
    "sk_survival_mod": {
      "formula": "awareness + sk_survival",
      "label": "Survival (AWA)"
    },
    "sk_custom_1_mod": {
      "formula": "(sk_custom_1_attr == 'STR' ? strength : (sk_custom_1_attr == 'SPD' ? speed : (sk_custom_1_attr == 'INT' ? intellect : (sk_custom_1_attr == 'WIL' ? willpower : (sk_custom_1_attr == 'AWA' ? awareness : (sk_custom_1_attr == 'PRE' ? presence : (0))))))) + sk_custom_1",
      "label": "Additional skill 1 modifier"
    },
    "sk_custom_2_mod": {
      "formula": "(sk_custom_2_attr == 'STR' ? strength : (sk_custom_2_attr == 'SPD' ? speed : (sk_custom_2_attr == 'INT' ? intellect : (sk_custom_2_attr == 'WIL' ? willpower : (sk_custom_2_attr == 'AWA' ? awareness : (sk_custom_2_attr == 'PRE' ? presence : (0))))))) + sk_custom_2",
      "label": "Additional skill 2 modifier"
    },
    "sk_custom_3_mod": {
      "formula": "(sk_custom_3_attr == 'STR' ? strength : (sk_custom_3_attr == 'SPD' ? speed : (sk_custom_3_attr == 'INT' ? intellect : (sk_custom_3_attr == 'WIL' ? willpower : (sk_custom_3_attr == 'AWA' ? awareness : (sk_custom_3_attr == 'PRE' ? presence : (0))))))) + sk_custom_3",
      "label": "Additional skill 3 modifier"
    },
    "attribute_points": {
      "formula": "12 + (level >= 3 ? 1 : 0) + (level >= 6 ? 1 : 0) + (level >= 9 ? 1 : 0) + (level >= 12 ? 1 : 0) + (level >= 15 ? 1 : 0) + (level >= 18 ? 1 : 0)",
      "label": "Attribute Points"
    },
    "attribute_points_spent": {
      "formula": "strength + speed + intellect + willpower + awareness + presence",
      "label": "Attribute Points Spent"
    },
    "skill_ranks": {
      "formula": "4 + 2 * (min(level, 20) - 1)",
      "label": "Skill Ranks"
    },
    "skill_ranks_spent": {
      "formula": "sum(sk_agility, sk_athletics, sk_heavy_weaponry, sk_light_weaponry, sk_stealth, sk_thievery, sk_crafting, sk_deduction, sk_discipline, sk_intimidation, sk_lore, sk_medicine, sk_deception, sk_insight, sk_leadership, sk_perception, sk_persuasion, sk_survival, sk_custom_1, sk_custom_2, sk_custom_3)",
      "label": "Skill Ranks Spent"
    },
    "max_skill_rank": {
      "formula": "level <= 5 ? 2 : (level <= 10 ? 3 : (level <= 15 ? 4 : 5))",
      "label": "Highest Skill Rank"
    }
  },
  "validators": [
    {
      "rule": "attribute_points_spent <= attribute_points",
      "message": "More attribute points spent than the level gives."
    },
    {
      "rule": "skill_ranks_spent <= skill_ranks",
      "message": "More skill ranks spent than the level gives (level 21 may trade a talent for one)."
    },
    {
      "rule": "max(sk_agility, sk_athletics, sk_heavy_weaponry, sk_light_weaponry, sk_stealth, sk_thievery, sk_crafting, sk_deduction, sk_discipline, sk_intimidation, sk_lore, sk_medicine, sk_deception, sk_insight, sk_leadership, sk_perception, sk_persuasion, sk_survival, sk_custom_1, sk_custom_2, sk_custom_3) <= max_skill_rank",
      "message": "A skill has more ranks than this tier allows."
    },
    {
      "rule": "health <= health_max and focus <= focus_max",
      "message": "Health or focus is above its maximum."
    }
  ]
}
