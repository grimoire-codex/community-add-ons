        }
      ]
    },
    "subclass": {
      "type": "content_ref",
      "label": "Subclass",
      "content_type": "subclass",
      "on_pick": [
        {
          "grant": "features",
          "from": "feature_ids",
          "names": "feature_names",
          "carry": {
            "origin": "class"
          }
        }
      ]
    },
    "kit": {
      "type": "content_ref",
      "label": "Kit",
      "content_type": "kit",
      "on_pick": [
        {
          "grant": "abilities",
          "from": "ability_ids",
          "names": "ability_names",
          "carry": {
            "origin": "name"
          }
        }
      ]
    },
    "complication": {
      "type": "content_ref",
      "label": "Complication",
      "content_type": "complication"
    },
    "inciting_incident": {
      "type": "textarea",
      "label": "Inciting Incident",
      "rows": 3
    },
    "might": {
      "type": "number",
      "label": "Might",
      "min": -5,
      "max": 5,
      "default": 0,
      "default_from": "contains(ref(klass, 'primary_characteristics'), 'Might') ? 2 : 0"
    },
    "agility": {
      "type": "number",
      "label": "Agility",
      "min": -5,
      "max": 5,
      "default": 0,
      "default_from": "contains(ref(klass, 'primary_characteristics'), 'Agility') ? 2 : 0"
    },
    "reason": {
      "type": "number",
      "label": "Reason",
      "min": -5,
      "max": 5,
      "default": 0,
      "default_from": "contains(ref(klass, 'primary_characteristics'), 'Reason') ? 2 : 0"
    },
    "intuition": {
      "type": "number",
      "label": "Intuition",
      "min": -5,
      "max": 5,
      "default": 0,
      "default_from": "contains(ref(klass, 'primary_characteristics'), 'Intuition') ? 2 : 0"
    },
    "presence": {
      "type": "number",
      "label": "Presence",
      "min": -5,
      "max": 5,
      "default": 0,
      "default_from": "contains(ref(klass, 'primary_characteristics'), 'Presence') ? 2 : 0"
    },
    "stamina_max": {
      "type": "number",
      "label": "Stamina Maximum",
      "min": 0,
      "default": 20,
      "default_from": "ref(klass, 'stamina') ? ref(klass, 'stamina') + ref(klass, 'stamina_per_level') * (level - 1) + ref(kit, 'stamina') * min(4, floor((level - 1) / 3) + 1) : ''"
    },
    "stamina_current": {
      "type": "number",
      "label": "Current Stamina",
      "default": 20,
      "default_from": "stamina_max"
    },
    "stamina_temp": {
      "type": "number",
      "label": "Temporary Stamina",
      "min": 0,
      "default": 0
    },
    "recoveries_max": {
      "type": "number",
      "label": "Recoveries",
      "min": 0,
      "default": 8,
      "default_from": "ref(klass, 'recoveries') ? ref(klass, 'recoveries') : ''"
    },
    "recoveries_used": {
      "type": "number",
      "label": "Recoveries Spent",
      "min": 0,
      "default": 0
    },
    "resource_name": {
      "type": "text",
      "label": "Heroic Resource",
      "placeholder": "Focus, Drama, Ferocity…",
      "default_from": "ref(klass, 'heroic_resource')"
    },
    "heroic_resource": {
      "type": "number",
      "label": "Heroic Resource",
      "min": 0,
      "default": 0
    },
    "surges": {
      "type": "number",
      "label": "Surges",
      "min": 0,
      "default": 0
    },
    "victories": {
      "type": "number",
      "label": "Victories",
      "min": 0,
      "default": 0
    },
    "renown": {
      "type": "number",
      "label": "Renown",
      "min": 0,
      "default": 0
    },
    "wealth": {
      "type": "number",
      "label": "Wealth",
      "min": 0,
      "default": 1
    },
    "speed": {
      "type": "number",
      "label": "Speed",
      "min": 0,
      "default": 5,
      "default_from": "(ref(ancestry, 'speed') ? ref(ancestry, 'speed') : 5) + ref(kit, 'speed')"
    },
    "stability": {
      "type": "number",
      "label": "Stability",
      "min": 0,
      "default": 0,
      "default_from": "0 + ref(kit, 'stability')"
    },
    "size": {
      "type": "text",
      "label": "Size",
      "default": "1M",
      "default_from": "ref(ancestry, 'size')"
    },
    "disengage": {
      "type": "number",
      "label": "Disengage",
      "min": 0,
      "default": 1,
      "default_from": "1 + ref(kit, 'disengage')"
    },
    "melee_damage_bonus": {
      "type": "text",
      "label": "Melee Damage Bonus",
      "placeholder": "+0/+0/+0",
      "default_from": "ref(kit, 'melee_damage')"
    },
    "ranged_damage_bonus": {
      "type": "text",
      "label": "Ranged Damage Bonus",
      "placeholder": "+0/+0/+0",
      "default_from": "ref(kit, 'ranged_damage')"
    },
    "melee_distance_bonus": {
      "type": "number",
      "label": "Melee Distance Bonus",
      "min": 0,
      "default": 0,
      "default_from": "0 + ref(kit, 'melee_distance')"
    },
    "ranged_distance_bonus": {
      "type": "number",
      "label": "Ranged Distance Bonus",
      "min": 0,
      "default": 0,
      "default_from": "0 + ref(kit, 'ranged_distance')"
    },
    "conditions": {
      "type": "multiselect",
      "label": "Conditions",
      "options": [
        "Bleeding",
        "Dazed",
        "Frightened",
        "Grabbed",
        "Prone",
        "Restrained",
        "Slowed",
        "Taunted",
        "Weakened"
      ]
    },
    "skills": {
      "type": "multiselect",
      "label": "Skills",
      "options": [
        "Alchemy",
        "Alertness",
        "Architecture",
        "Blacksmithing",
        "Brag",
        "Carpentry",
        "Climb",
        "Conceal Object",
        "Cooking",
        "Criminal Underworld",
        "Culture",
        "Disguise",
        "Drive",
        "Eavesdrop",
        "Empathize",
        "Endurance",
        "Escape Artist",
        "Fletching",
        "Flirt",
        "Forgery",
