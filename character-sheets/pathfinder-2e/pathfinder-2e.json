  "fields": {
    "hero_name": {
      "type": "text",
      "label": "Character Name"
    },
    "player": {
      "type": "text",
      "label": "Player"
    },
    "level": {
      "type": "number",
      "label": "Level",
      "min": 1,
      "max": 20,
      "default": 1
    },
    "xp": {
      "type": "number",
      "label": "XP",
      "min": 0,
      "default": 0
    },
    "ancestry": {
      "type": "content_ref",
      "label": "Ancestry",
      "content_type": "ancestry",
      "on_pick": [
        {
          "grant": "features",
          "from": "feature_ids",
          "names": "feature_names",
          "carry": {
            "origin": "name"
          }
        }
      ]
    },
    "heritage": {
      "type": "content_ref",
      "label": "Heritage",
      "content_type": "heritage"
    },
    "background": {
      "type": "content_ref",
      "label": "Background",
      "content_type": "background",
      "on_pick": [
        {
          "grant": "skills_trained",
          "from": "skills"
        },
        {
          "choose": "skills_trained",
          "count": 1,
          "from": "either_skills",
          "label": "Choose your background's skill"
        },
        {
          "grant": "feats",
          "ref": "feat_id",
          "name": "feat"
        }
      ]
    },
    "klass": {
      "type": "content_ref",
      "label": "Class",
      "content_type": "class",
      "on_pick": [
        {
          "grant": "skills_trained",
          "from": "trained_skills"
        },
        {
          "choose": "skills_trained",
          "count": 1,
          "from": "either_skills",
          "label": "Choose your class's skill"
        },
        {
          "choose": "skills_trained",
          "count": "additional_skills",
          "from": "skill_options",
          "label": "Choose more trained skills - one more for each point of Intelligence modifier"
        },
        {
          "grant": "features",
          "from": "feature_ids",
          "names": "feature_names",
          "carry": {
            "origin": "name"
          }
        }
      ]
    },
    "deity": {
      "type": "text",
      "label": "Deity"
    },
    "size": {
      "type": "select",
      "label": "Size",
      "options": [
        "Tiny",
        "Small",
        "Medium",
        "Large",
        "Huge",
        "Gargantuan"
      ],
      "default": "Medium",
      "default_from": "ref(ancestry, 'size')"
    },
    "strength": {
      "type": "number",
      "label": "Strength",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "dexterity": {
      "type": "number",
      "label": "Dexterity",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "constitution": {
      "type": "number",
      "label": "Constitution",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "intelligence": {
      "type": "number",
      "label": "Intelligence",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "wisdom": {
      "type": "number",
      "label": "Wisdom",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "charisma": {
      "type": "number",
      "label": "Charisma",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "hp_max": {
      "type": "number",
      "label": "Max HP",
      "min": 0,
      "default": 10,
      "default_from": "ref(klass, 'hp_per_level') ? ref(ancestry, 'hp') + (ref(klass, 'hp_per_level') + constitution) * level : ''"
    },
    "hp_current": {
      "type": "number",
      "label": "Current HP",
      "min": 0,
      "default": 10,
      "default_from": "hp_max"
    },
    "hp_temp": {
      "type": "number",
      "label": "Temporary HP",
      "min": 0,
      "default": 0
    },
    "dying": {
      "type": "number",
      "label": "Dying",
      "min": 0,
      "max": 4,
      "default": 0
    },
    "wounded": {
      "type": "number",
      "label": "Wounded",
      "min": 0,
      "max": 3,
      "default": 0
    },
    "doomed": {
      "type": "number",
      "label": "Doomed",
      "min": 0,
      "max": 3,
