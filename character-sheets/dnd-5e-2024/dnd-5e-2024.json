{
  "$schema": "../../schema/character-sheet.schema.json",
  "id": "dnd-5e-2024",
  "name": "D&D 5th Edition (2024)",
  "version": "1.3.0",
  "system": "Dungeons & Dragons 5th Edition (2024)",
  "description": "A character sheet for the 2024 revision of D&D 5th Edition, with the SRD 5.2 catalogue of classes, species, backgrounds, feats and spells.",
  "author": "hunter-read",
  "homepage": "https://www.dndbeyond.com/srd",
  "license": "CC-BY-4.0",
  "license_url": "https://creativecommons.org/licenses/by/4.0/",
  "attribution": "This work includes material from the System Reference Document 5.2 (“SRD 5.2”) by Wizards of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2 is licensed under the Creative Commons Attribution 4.0 International License, available at https://creativecommons.org/licenses/by/4.0/legalcode.",
  "content_types": {
    "class": {
      "label": "Class",
      "label_plural": "Classes",
      "identity_field": "name",
      "sort_default": [
        "name"
      ],
      "search_fields": [
        "name",
        "description"
      ],
      "filter_fields": [
        "hit_die"
      ],
      "compact_display": "{name} — d{hit_die}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "hit_die": {
          "type": "number",
          "label": "Hit Die"
        },
        "primary_ability": {
          "type": "text",
          "label": "Primary Ability"
        },
        "saving_throws": {
          "type": "text",
          "label": "Saving Throw Proficiencies"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        },
        "spellcasting": {
          "type": "select",
          "label": "Spellcasting Ability",
          "options": [
            {
              "value": "",
              "label": "None"
            },
            {
              "value": "intelligence",
              "label": "Intelligence"
            },
            {
              "value": "wisdom",
              "label": "Wisdom"
            },
            {
              "value": "charisma",
              "label": "Charisma"
            }
          ]
        },
        "caster_type": {
          "type": "select",
          "label": "Caster Type",
          "options": [
            {
              "value": "",
              "label": "None"
            },
            {
              "value": "full",
              "label": "Full"
            },
            {
              "value": "half",
              "label": "Half"
            },
            {
              "value": "pact",
              "label": "Pact Magic"
            }
          ]
        },
        "caster_from_level": {
          "type": "number",
          "label": "Spellcasting From Level",
          "min": 0,
          "max": 20
        },
        "skill_choices": {
          "type": "number",
          "label": "Skill Choices",
          "min": 0,
          "max": 18
        },
        "skill_options": {
          "type": "multiselect",
          "label": "Skill Options",
          "options": [
            "Acrobatics",
            "Animal Handling",
            "Arcana",
            "Athletics",
            "Deception",
            "History",
            "Insight",
            "Intimidation",
            "Investigation",
            "Medicine",
            "Nature",
            "Perception",
            "Performance",
            "Persuasion",
            "Religion",
            "Sleight of Hand",
            "Stealth",
            "Survival"
          ]
        }
      }
    },
    "species": {
      "label": "Species",
      "label_plural": "Species",
      "identity_field": "name",
      "sort_default": [
        "name"
      ],
      "search_fields": [
        "name",
        "description"
      ],
      "filter_fields": [
        "size"
      ],
      "compact_display": "{name} — {size}, speed {speed}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "size": {
          "type": "text",
          "label": "Size"
        },
        "speed": {
          "type": "number",
          "label": "Speed"
        },
        "traits": {
          "type": "textarea",
          "label": "Traits"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    },
    "background": {
      "label": "Background",
      "label_plural": "Backgrounds",
      "identity_field": "name",
      "sort_default": [
        "name"
      ],
      "search_fields": [
        "name",
        "description"
      ],
      "filter_fields": [],
      "compact_display": "{name} — {ability_scores}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "ability_scores": {
          "type": "text",
          "label": "Ability Scores"
        },
        "feat": {
          "type": "text",
          "label": "Origin Feat"
        },
        "skill_proficiencies": {
          "type": "multiselect",
          "label": "Skill Proficiencies",
          "options": [
            "Acrobatics",
            "Animal Handling",
            "Arcana",
            "Athletics",
            "Deception",
            "History",
            "Insight",
            "Intimidation",
            "Investigation",
            "Medicine",
            "Nature",
            "Perception",
            "Performance",
            "Persuasion",
            "Religion",
            "Sleight of Hand",
            "Stealth",
            "Survival"
          ]
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        },
        "feat_id": {
          "type": "text",
          "label": "Origin Feat Id"
        }
      }
    },
    "feat": {
      "label": "Feat",
      "label_plural": "Feats",
      "identity_field": "name",
      "sort_default": [
        "category",
        "name"
      ],
      "search_fields": [
        "name",
        "description"
      ],
      "filter_fields": [
        "category"
      ],
      "compact_display": "{name} — {category}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "category": {
          "type": "text",
          "label": "Category"
        },
        "prerequisite": {
          "type": "text",
          "label": "Prerequisite"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    },
    "spell": {
      "label": "Spell",
      "label_plural": "Spells",
      "identity_field": "name",
      "sort_default": [
        "level",
        "name"
      ],
      "search_fields": [
        "name",
        "school",
        "description"
      ],
      "filter_fields": [
        "level",
        "school",
        "concentration",
        "ritual"
      ],
      "compact_display": "{name} — {school} {level}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "level": {
          "type": "number",
          "label": "Level",
          "min": 0,
          "max": 9
        },
        "school": {
          "type": "text",
          "label": "School"
        },
        "casting_time": {
          "type": "text",
          "label": "Casting Time"
        },
        "range": {
          "type": "text",
          "label": "Range"
        },
        "components": {
          "type": "text",
          "label": "Components"
        },
        "duration": {
          "type": "text",
          "label": "Duration"
        },
        "concentration": {
          "type": "checkbox",
          "label": "Concentration"
        },
        "ritual": {
          "type": "checkbox",
          "label": "Ritual"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    }
  },
  "fields": {
    "hero_name": {
      "type": "text",
      "label": "Character Name"
    },
    "player_name": {
      "type": "text",
      "label": "Player"
    },
    "level": {
      "type": "number",
      "label": "Level",
      "min": 1,
      "max": 20,
      "default": 1
    },
    "xp": {
      "type": "number",
      "label": "XP",
      "min": 0,
      "default": 0
    },
    "species": {
      "type": "content_ref",
      "label": "Species",
      "content_type": "species"
    },
    "background": {
      "type": "content_ref",
      "label": "Background",
      "content_type": "background",
      "on_pick": [
        {
          "grant": "skill_profs",
          "from": "skill_proficiencies"
        },
        {
          "grant": "feats",
          "ref": "feat_id",
          "name": "feat"
        }
      ]
    },
    "klass": {
      "type": "content_ref",
      "label": "Class",
      "content_type": "class",
      "on_pick": [
        {
          "choose": "skill_profs",
          "count": "skill_choices",
          "from": "skill_options",
          "label": "Choose class skill proficiencies"
        }
      ]
    },
    "subclass": {
      "type": "text",
      "label": "Subclass"
    },
    "alignment": {
      "type": "select",
      "label": "Alignment",
      "options": [
        "Lawful Good",
        "Neutral Good",
        "Chaotic Good",
        "Lawful Neutral",
        "True Neutral",
        "Chaotic Neutral",
        "Lawful Evil",
        "Neutral Evil",
        "Chaotic Evil"
      ]
    },
    "strength": {
      "type": "number",
      "label": "Strength (base)",
      "min": 1,
      "max": 30,
      "default": 10
    },
    "strength_bonus": {
      "type": "number",
      "label": "Strength background bonus",
      "min": 0,
      "max": 2,
      "default": 0
    },
    "strength_save_prof": {
      "type": "checkbox",
      "label": "STR save proficiency",
      "default_from": "contains(ref(klass, 'saving_throws'), 'strength')"
    },
    "dexterity": {
      "type": "number",
      "label": "Dexterity (base)",
      "min": 1,
      "max": 30,
      "default": 10
    },
    "dexterity_bonus": {
      "type": "number",
      "label": "Dexterity background bonus",
      "min": 0,
      "max": 2,
      "default": 0
    },
    "dexterity_save_prof": {
      "type": "checkbox",
      "label": "DEX save proficiency",
      "default_from": "contains(ref(klass, 'saving_throws'), 'dexterity')"
    },
    "constitution": {
      "type": "number",
      "label": "Constitution (base)",
      "min": 1,
      "max": 30,
      "default": 10
    },
    "constitution_bonus": {
      "type": "number",
      "label": "Constitution background bonus",
      "min": 0,
      "max": 2,
      "default": 0
    },
    "constitution_save_prof": {
      "type": "checkbox",
      "label": "CON save proficiency",
      "default_from": "contains(ref(klass, 'saving_throws'), 'constitution')"
    },
    "intelligence": {
      "type": "number",
      "label": "Intelligence (base)",
      "min": 1,
      "max": 30,
      "default": 10
    },
    "intelligence_bonus": {
      "type": "number",
      "label": "Intelligence background bonus",
      "min": 0,
      "max": 2,
      "default": 0
    },
    "intelligence_save_prof": {
      "type": "checkbox",
      "label": "INT save proficiency",
      "default_from": "contains(ref(klass, 'saving_throws'), 'intelligence')"
    },
    "wisdom": {
      "type": "number",
      "label": "Wisdom (base)",
      "min": 1,
      "max": 30,
      "default": 10
    },
    "wisdom_bonus": {
      "type": "number",
      "label": "Wisdom background bonus",
      "min": 0,
      "max": 2,
      "default": 0
    },
    "wisdom_save_prof": {
      "type": "checkbox",
      "label": "WIS save proficiency",
      "default_from": "contains(ref(klass, 'saving_throws'), 'wisdom')"
    },
    "charisma": {
      "type": "number",
      "label": "Charisma (base)",
      "min": 1,
      "max": 30,
      "default": 10
    },
    "charisma_bonus": {
      "type": "number",
      "label": "Charisma background bonus",
      "min": 0,
      "max": 2,
      "default": 0
    },
    "charisma_save_prof": {
      "type": "checkbox",
      "label": "CHA save proficiency",
      "default_from": "contains(ref(klass, 'saving_throws'), 'charisma')"
    },
    "ability_method": {
      "type": "select",
      "label": "Ability score method",
      "default": "manual",
      "options": [
        {
          "value": "manual",
          "label": "Rolled or manual"
        },
        {
          "value": "standard_array",
          "label": "Standard array"
        },
        {
          "value": "point_buy",
          "label": "Point buy"
        }
      ]
    },
    "hp_max": {
      "type": "number",
      "label": "HP Maximum",
      "min": 0,
      "default": 8,
      "default_from": "ref(klass, 'hit_die') ? ref(klass, 'hit_die') + floor((constitution - 10) / 2) + (level - 1) * (floor(ref(klass, 'hit_die') / 2) + 1 + floor((constitution - 10) / 2)) : ''"
    },
    "hp_current": {
      "type": "number",
      "label": "Current HP",
      "min": 0,
      "default": 8
    },
    "hp_temp": {
      "type": "number",
      "label": "Temporary HP",
      "min": 0,
      "default": 0
    },
    "hit_dice": {
      "type": "text",
      "label": "Hit Dice",
      "default_from": "ref(klass, 'hit_die') ? concat(level, 'd', ref(klass, 'hit_die')) : ''"
    },
    "hit_dice_spent": {
      "type": "number",
      "label": "Hit Dice Spent",
      "min": 0,
      "default": 0
    },
    "death_success_1": {
      "type": "checkbox",
      "label": "Death save success 1"
    },
    "death_success_2": {
      "type": "checkbox",
      "label": "Death save success 2"
    },
    "death_success_3": {
      "type": "checkbox",
      "label": "Death save success 3"
    },
    "death_failure_1": {
      "type": "checkbox",
      "label": "Death save failure 1"
    },
    "death_failure_2": {
      "type": "checkbox",
      "label": "Death save failure 2"
    },
    "death_failure_3": {
      "type": "checkbox",
      "label": "Death save failure 3"
    },
    "armor_bonus": {
      "type": "number",
      "label": "Armour Class Bonus",
      "default": 0,
      "placeholder": "Armour, shield and other bonuses"
    },
    "shield": {
      "type": "checkbox",
      "label": "Shield"
    },
    "speed": {
      "type": "number",
      "label": "Speed",
      "min": 0,
      "default": 30,
      "default_from": "ref(species, 'speed')"
    },
    "size": {
      "type": "text",
      "label": "Size",
      "default": "Medium",
      "default_from": "ref(species, 'size')"
    },
    "heroic_inspiration": {
      "type": "checkbox",
      "label": "Heroic Inspiration"
    },
    "skill_profs": {
      "type": "multiselect",
      "label": "Skill Proficiencies",
      "options": [
        "Acrobatics",
        "Animal Handling",
        "Arcana",
        "Athletics",
        "Deception",
        "History",
        "Insight",
        "Intimidation",
        "Investigation",
        "Medicine",
        "Nature",
        "Perception",
        "Performance",
        "Persuasion",
        "Religion",
        "Sleight of Hand",
        "Stealth",
        "Survival"
      ]
    },
    "skill_expertise": {
      "type": "multiselect",
      "label": "Skill Expertise",
      "options": [
        "Acrobatics",
        "Animal Handling",
        "Arcana",
        "Athletics",
        "Deception",
        "History",
        "Insight",
        "Intimidation",
        "Investigation",
        "Medicine",
        "Nature",
        "Perception",
        "Performance",
        "Persuasion",
        "Religion",
        "Sleight of Hand",
        "Stealth",
        "Survival"
      ]
    },
    "is_caster": {
      "type": "checkbox",
      "label": "Spellcaster",
      "default_from": "ref(klass, 'spellcasting') != ''"
    },
    "spell_ability": {
      "type": "select",
      "label": "Spellcasting Ability",
      "visible_if": "is_caster",
      "options": [
        {
          "value": "intelligence",
          "label": "Intelligence"
        },
        {
          "value": "wisdom",
          "label": "Wisdom"
        },
        {
          "value": "charisma",
          "label": "Charisma"
        }
      ],
      "default_from": "ref(klass, 'spellcasting')"
    },
    "slots_1_total": {
      "type": "number",
      "label": "Level 1 slots",
      "min": 0,
      "max": 9,
