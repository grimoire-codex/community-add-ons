        "Sabotage",
        "Search",
        "Sneak",
        "Society",
        "Strategy",
        "Swim",
        "Tailoring",
        "Track"
      ]
    },
    "languages": {
      "type": "text",
      "label": "Languages",
      "placeholder": "Caelian, …"
    },
    "ancestry_traits": {
      "type": "content_list",
      "label": "Ancestry Traits",
      "content_type": "trait",
      "allow_freeform": true,
      "display_columns": [
        "cost"
      ]
    },
    "features": {
      "type": "content_list",
      "label": "Features",
      "content_type": "feature",
      "allow_freeform": true,
      "display_columns": [
        "level"
      ]
    },
    "abilities": {
      "type": "content_list",
      "label": "Abilities",
      "content_type": "ability",
      "allow_freeform": true,
      "display_columns": [
        "cost",
        "type",
        "distance"
      ]
    },
    "domains": {
      "type": "content_list",
      "label": "Domains",
      "content_type": "domain",
      "allow_freeform": true
    },
    "perks": {
      "type": "content_list",
      "label": "Perks",
      "content_type": "perk",
      "allow_freeform": true,
      "display_columns": [
        {
          "key": "list",
          "label": "Type"
        }
      ]
    },
    "titles": {
      "type": "content_list",
      "label": "Titles",
      "content_type": "title",
      "allow_freeform": true,
      "display_columns": [
        "echelon"
      ]
    },
    "equipment": {
      "type": "list",
      "label": "Equipment",
      "columns": [
        {
          "key": "name",
          "type": "text",
          "label": "Item",
          "flex": 3
        },
        {
          "key": "qty",
          "type": "number",
          "label": "Qty",
          "default": 1,
          "min": 0,
          "flex": 1
        },
        {
          "key": "notes",
          "type": "text",
          "label": "Notes",
          "flex": 2
        }
      ]
    },
    "projects": {
      "type": "list",
      "label": "Projects",
      "columns": [
        {
          "key": "name",
          "type": "text",
          "label": "Project",
          "flex": 3
        },
        {
          "key": "goal",
          "type": "number",
          "label": "Goal",
          "min": 0,
          "flex": 1
        },
        {
          "key": "points",
          "type": "number",
          "label": "Points",
          "min": 0,
          "flex": 1
        }
      ]
    },
    "notes": {
      "type": "textarea",
      "label": "Notes",
      "rows": 6
    }
  },
  "computed": {
    "echelon": {
      "formula": "min(4, floor((level - 1) / 3) + 1)",
      "label": "Echelon"
    },
    "recoveries_left": {
      "formula": "max(0, recoveries_max - recoveries_used)",
      "label": "Recoveries Left"
    },
    "recovery_value": {
      "formula": "floor(stamina_max / 3)",
      "label": "Recovery Value"
    },
    "winded": {
      "formula": "floor(stamina_max / 2)",
      "label": "Winded At"
    },
    "is_winded": {
      "formula": "stamina_current <= 0 ? 'Dying' : (stamina_current <= winded ? 'Winded' : 'Steady')",
      "label": "Condition"
    },
    "dying_at": {
      "formula": "0 - winded",
      "label": "Dead At"
    },
    "potency_strong": {
      "formula": "max(might, agility, reason, intuition, presence)",
      "label": "Strong Potency"
    },
    "potency_average": {
      "formula": "potency_strong - 1",
      "label": "Average Potency"
    },
    "potency_weak": {
      "formula": "potency_strong - 2",
      "label": "Weak Potency"
    },
    "ancestry_points": {
      "formula": "ref(ancestry, 'ancestry_points') ? ref(ancestry, 'ancestry_points') : 0",
      "label": "Ancestry Points"
    },
    "ancestry_points_spent": {
      "formula": "sum_refs(ancestry_traits, 'cost')",
      "label": "Ancestry Points Spent"
    },
    "ability_count": {
      "formula": "count_refs(abilities)",
      "label": "Abilities Known"
    },
    "skill_count": {
      "formula": "len(skills)",
      "label": "Skills Known"
    },
    "might_display": {
      "formula": "signed(might)",
      "label": "Might"
    },
    "agility_display": {
      "formula": "signed(agility)",
      "label": "Agility"
    },
    "reason_display": {
      "formula": "signed(reason)",
      "label": "Reason"
    },
    "intuition_display": {
      "formula": "signed(intuition)",
      "label": "Intuition"
    },
    "presence_display": {
      "formula": "signed(presence)",
      "label": "Presence"
    }
  },
  "name_field": "hero_name",
  "validators": [
    {
      "rule": "ancestry_points_spent <= ancestry_points or ancestry_points == 0",
      "message": "The purchased traits cost more ancestry points than the ancestry gives."
    },
    {
      "rule": "stamina_current > dying_at",
      "message": "Stamina at or below the negative of the winded value: the hero is dead."
    }
  ],
  "layout_file": "draw-steel.html",
  "styles_file": "draw-steel.css"
}
