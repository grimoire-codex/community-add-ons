    "occupation_points_spent": {
      "formula": "(contains(occupation_skills, 'Accounting') ? max(0, sk_accounting - 5) : 0) + (contains(occupation_skills, 'Anthropology') ? max(0, sk_anthropology - 1) : 0) + (contains(occupation_skills, 'Appraise') ? max(0, sk_appraise - 5) : 0) + (contains(occupation_skills, 'Archaeology') ? max(0, sk_archaeology - 1) : 0) + (contains(occupation_skills, 'Charm') ? max(0, sk_charm - 15) : 0) + (contains(occupation_skills, 'Climb') ? max(0, sk_climb - 20) : 0) + max(0, sk_credit_rating - 0) + (contains(occupation_skills, 'Disguise') ? max(0, sk_disguise - 5) : 0) + (contains(occupation_skills, 'Dodge') ? max(0, sk_dodge - floor(dexterity / 2)) : 0) + (contains(occupation_skills, 'Drive Auto') ? max(0, sk_drive_auto - 20) : 0) + (contains(occupation_skills, 'Electrical Repair') ? max(0, sk_electrical_repair - 10) : 0) + (contains(occupation_skills, 'Fast Talk') ? max(0, sk_fast_talk - 5) : 0) + (contains(occupation_skills, 'Fighting (Brawl)') ? max(0, sk_fighting_brawl - 25) : 0) + (contains(occupation_skills, 'Firearms (Handgun)') ? max(0, sk_firearms_handgun - 20) : 0) + (contains(occupation_skills, 'Firearms (Rifle/Shotgun)') ? max(0, sk_firearms_rifle_shotgun - 25) : 0) + (contains(occupation_skills, 'First Aid') ? max(0, sk_first_aid - 30) : 0) + (contains(occupation_skills, 'History') ? max(0, sk_history - 5) : 0) + (contains(occupation_skills, 'Intimidate') ? max(0, sk_intimidate - 15) : 0) + (contains(occupation_skills, 'Jump') ? max(0, sk_jump - 20) : 0) + (contains(occupation_skills, 'Language (Own)') ? max(0, sk_language_own - education) : 0) + (contains(occupation_skills, 'Law') ? max(0, sk_law - 5) : 0) + (contains(occupation_skills, 'Library Use') ? max(0, sk_library_use - 20) : 0) + (contains(occupation_skills, 'Listen') ? max(0, sk_listen - 20) : 0) + (contains(occupation_skills, 'Locksmith') ? max(0, sk_locksmith - 1) : 0) + (contains(occupation_skills, 'Mechanical Repair') ? max(0, sk_mechanical_repair - 10) : 0) + (contains(occupation_skills, 'Medicine') ? max(0, sk_medicine - 1) : 0) + (contains(occupation_skills, 'Natural World') ? max(0, sk_natural_world - 10) : 0) + (contains(occupation_skills, 'Navigate') ? max(0, sk_navigate - 10) : 0) + (contains(occupation_skills, 'Occult') ? max(0, sk_occult - 5) : 0) + (contains(occupation_skills, 'Operate Heavy Machinery') ? max(0, sk_operate_heavy_machinery - 1) : 0) + (contains(occupation_skills, 'Persuade') ? max(0, sk_persuade - 10) : 0) + (contains(occupation_skills, 'Psychoanalysis') ? max(0, sk_psychoanalysis - 1) : 0) + (contains(occupation_skills, 'Psychology') ? max(0, sk_psychology - 10) : 0) + (contains(occupation_skills, 'Ride') ? max(0, sk_ride - 5) : 0) + (contains(occupation_skills, 'Sleight of Hand') ? max(0, sk_sleight_of_hand - 10) : 0) + (contains(occupation_skills, 'Spot Hidden') ? max(0, sk_spot_hidden - 25) : 0) + (contains(occupation_skills, 'Stealth') ? max(0, sk_stealth - 20) : 0) + (contains(occupation_skills, 'Survival') ? max(0, sk_survival - 10) : 0) + (contains(occupation_skills, 'Swim') ? max(0, sk_swim - 20) : 0) + (contains(occupation_skills, 'Throw') ? max(0, sk_throw - 20) : 0) + (contains(occupation_skills, 'Track') ? max(0, sk_track - 10) : 0) + (art_craft_1_occ ? max(0, art_craft_1 - art_craft_1_base) : 0) + (art_craft_2_occ ? max(0, art_craft_2 - art_craft_2_base) : 0) + (science_1_occ ? max(0, science_1 - science_1_base) : 0) + (science_2_occ ? max(0, science_2 - science_2_base) : 0) + (language_other_1_occ ? max(0, language_other_1 - language_other_1_base) : 0) + (language_other_2_occ ? max(0, language_other_2 - language_other_2_base) : 0) + (fighting_other_occ ? max(0, fighting_other - fighting_other_base) : 0) + (firearms_other_occ ? max(0, firearms_other - firearms_other_base) : 0) + (pilot_occ ? max(0, pilot - pilot_base) : 0) + (other_skill_1_occ ? max(0, other_skill_1 - other_skill_1_base) : 0) + (other_skill_2_occ ? max(0, other_skill_2 - other_skill_2_base) : 0) + (other_skill_3_occ ? max(0, other_skill_3 - other_skill_3_base) : 0)",
      "label": "Occupation Points Spent"
    },
    "personal_points": {
      "formula": "intelligence * 2",
      "label": "Personal Interest Points"
    },
    "personal_points_spent": {
      "formula": "(max(0, sk_accounting - 5) + max(0, sk_anthropology - 1) + max(0, sk_appraise - 5) + max(0, sk_archaeology - 1) + max(0, sk_charm - 15) + max(0, sk_climb - 20) + max(0, sk_credit_rating - 0) + max(0, sk_disguise - 5) + max(0, sk_dodge - floor(dexterity / 2)) + max(0, sk_drive_auto - 20) + max(0, sk_electrical_repair - 10) + max(0, sk_fast_talk - 5) + max(0, sk_fighting_brawl - 25) + max(0, sk_firearms_handgun - 20) + max(0, sk_firearms_rifle_shotgun - 25) + max(0, sk_first_aid - 30) + max(0, sk_history - 5) + max(0, sk_intimidate - 15) + max(0, sk_jump - 20) + max(0, sk_language_own - education) + max(0, sk_law - 5) + max(0, sk_library_use - 20) + max(0, sk_listen - 20) + max(0, sk_locksmith - 1) + max(0, sk_mechanical_repair - 10) + max(0, sk_medicine - 1) + max(0, sk_natural_world - 10) + max(0, sk_navigate - 10) + max(0, sk_occult - 5) + max(0, sk_operate_heavy_machinery - 1) + max(0, sk_persuade - 10) + max(0, sk_psychoanalysis - 1) + max(0, sk_psychology - 10) + max(0, sk_ride - 5) + max(0, sk_sleight_of_hand - 10) + max(0, sk_spot_hidden - 25) + max(0, sk_stealth - 20) + max(0, sk_survival - 10) + max(0, sk_swim - 20) + max(0, sk_throw - 20) + max(0, sk_track - 10) + max(0, art_craft_1 - art_craft_1_base) + max(0, art_craft_2 - art_craft_2_base) + max(0, science_1 - science_1_base) + max(0, science_2 - science_2_base) + max(0, language_other_1 - language_other_1_base) + max(0, language_other_2 - language_other_2_base) + max(0, fighting_other - fighting_other_base) + max(0, firearms_other - firearms_other_base) + max(0, pilot - pilot_base) + max(0, other_skill_1 - other_skill_1_base) + max(0, other_skill_2 - other_skill_2_base) + max(0, other_skill_3 - other_skill_3_base)) - occupation_points_spent",
      "label": "Personal Interest Points Spent"
    },
    "damage_bonus": {
      "formula": "(strength + size) <= 64 ? '-2' : ((strength + size) <= 84 ? '-1' : ((strength + size) <= 124 ? 'None' : ((strength + size) <= 164 ? '+1D4' : ((strength + size) <= 204 ? '+1D6' : concat('+', floor(((strength + size) - 205) / 80) + 2, 'D6')))))",
      "label": "Damage Bonus"
    },
    "build": {
      "formula": "(strength + size) <= 64 ? -2 : ((strength + size) <= 84 ? -1 : ((strength + size) <= 124 ? 0 : ((strength + size) <= 164 ? 1 : ((strength + size) <= 204 ? 2 : floor(((strength + size) - 205) / 80) + 3))))",
      "label": "Build"
    },
    "move": {
      "formula": "((dexterity < size and strength < size) ? 7 : ((dexterity > size and strength > size) ? 9 : 8)) - (age >= 40 ? min(5, floor((age - 30) / 10)) : 0)",
      "label": "Move Rate"
    },
    "sanity_max": {
      "formula": "99 - sk_cthulhu_mythos",
      "label": "Maximum Sanity"
    },
    "luck_half": {
      "formula": "floor(luck / 2)",
      "label": "Luck half"
    },
    "luck_fifth": {
      "formula": "floor(luck / 5)",
      "label": "Luck fifth"
    },
    "sanity_fifth": {
      "formula": "floor(sanity_current / 5)",
      "label": "One-fifth Sanity"
    }
  },
  "name_field": "investigator_name",
  "validators": [
    {
      "rule": "creation_done or occupation_points_spent <= occupation_points",
      "message": "More occupation skill points spent than the occupation gives."
    },
    {
      "rule": "creation_done or personal_points_spent <= personal_points",
      "message": "More personal interest points spent than INT × 2."
    },
    {
      "rule": "sanity_current <= sanity_max",
      "message": "Sanity is above 99 minus Cthulhu Mythos."
    },
    {
      "rule": "hp_current <= hp_max",
      "message": "Hit points are above the maximum."
    }
  ],
  "layout_file": "call-of-cthulhu-7e.html",
  "styles_file": "call-of-cthulhu-7e.css"
}
