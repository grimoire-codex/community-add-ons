    "career": {
      "type": "content_ref",
      "label": "Career",
      "content_type": "career",
      "on_pick": [
        {
          "choose": "skills",
          "count": "skill_choices_1",
          "from": "skill_options_1",
          "label": "Choose a skill from your career"
        },
        {
          "choose": "skills",
          "count": "skill_choices_2",
          "from": "skill_options_2",
          "label": "Choose a skill from your career"
        },
        {
          "choose": "skills",
          "count": "skill_choices_3",
          "from": "skill_options_3",
          "label": "Choose a skill from your career"
