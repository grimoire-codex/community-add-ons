      ]
    },
    "klass": {
      "type": "content_ref",
      "label": "Class",
      "content_type": "class",
      "on_pick": [
        {
          "grant": "features",
          "from": "feature_ids",
          "names": "feature_names",
          "carry": {
            "origin": "name"
          }
        },
        {
          "choose": "skills",
          "count": "skill_choices",
          "from": "skill_options",
