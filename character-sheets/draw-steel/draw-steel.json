          "grant": "abilities",
          "from": "ability_ids",
          "names": "ability_names",
          "carry": {
            "origin": "name"
          }
        }
      ]
    },
    "culture": {
      "type": "content_ref",
      "label": "Culture",
      "content_type": "culture",
      "on_pick": [
        {
          "choose": "skills",
          "count": "skill_choices_1",
          "from": "skill_options_1",
          "label": "Choose a skill from your culture"
        },
        {
          "choose": "skills",
          "count": "skill_choices_2",
          "from": "skill_options_2",
          "label": "Choose a skill from your culture"
        },
        {
          "choose": "skills",
          "count": "skill_choices_3",
          "from": "skill_options_3",
          "label": "Choose a skill from your culture"
        }
