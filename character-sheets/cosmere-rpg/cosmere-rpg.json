    "health_max": {
      "type": "number",
      "label": "Maximum Health",
      "min": 0,
      "default": 12,
      "default_from": "10 + 5 * (min(level, 5) - 1) + 4 * clamp(level - 5, 0, 5) + 3 * clamp(level - 10, 0, 5) + 2 * clamp(level - 15, 0, 5) + clamp(level - 20, 0, 1) + strength * (1 + (level >= 6 ? 1 : 0) + (level >= 11 ? 1 : 0) + (level >= 16 ? 1 : 0))"
    },
    "health": {
      "type": "number",
      "label": "Current Health",
      "min": 0,
      "default": 12,
      "default_from": "health_max"
    },
    "focus_max": {
      "type": "number",
      "label": "Maximum Focus",
      "min": 0,
      "default": 4,
      "default_from": "2 + willpower"
    },
    "focus": {
      "type": "number",
      "label": "Current Focus",
      "min": 0,
      "default": 4,
      "default_from": "focus_max"
    },
    "invested": {
      "type": "checkbox",
      "label": "Uses Investiture (Allomancy or another Invested power)"
    },
    "investiture_max": {
      "type": "number",
      "label": "Maximum Investiture",
      "min": 0,
      "default": 0,
      "default_from": "invested ? 2 + max(awareness, presence) : 0"
    },
    "investiture": {
